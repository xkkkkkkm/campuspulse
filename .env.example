# Run python3 tools/dev.py init to create .env with unique application secrets.
# Demo credentials are public. Production must use a new database and real SMTP.
SPRING_PROFILES_ACTIVE=demo
MYSQL_DATABASE=campus_pulse
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=local-root-demo-password
DB_USERNAME=campus_pulse
DB_PASSWORD=campus_pulse_123
BACKEND_PORT=8080
FRONTEND_PORT=8125
APP_SECURITY_TOKEN_SECRET=replace-with-a-random-token-secret
APP_SECURITY_EMAIL_SECRET=replace-with-a-random-email-secret
APP_SECURITY_EMAIL_DEV_MODE=true
APP_SECURITY_EMAIL_FROM='CampusPulse <no-reply@example.com>'
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8125,http://localhost:8125

# Fresh prod database only; remove bootstrap password after the first successful start.
APP_ADMIN_USERNAME=administrator
APP_ADMIN_PASSWORD=
APP_ADMIN_EMAIL=
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
# Deployer configuration; website visitors do not enter a model key.
# Recommended Compose setup: README.md#enable-model-generated-support-optional
# 中文步骤: README.zh-CN.md#启用模型生成客服可选
# Without model configuration, LangGraph only matches reviewed local guide phrases.
# The provider adapter is implemented; a live provider has not been verified.
# Generated by tools/dev.py init; Java and Python must share this internal token.
# SUPPORT_AGENT_TOKEN is NOT the provider API key below. Do not generate another one.
SUPPORT_AGENT_TOKEN=replace-with-a-random-support-agent-token
SUPPORT_AGENT_ENABLED=true
# Enable only after the deployer supplies the provider key, API base URL and model ID.
# Logged-in user, remaining quota, matching guide and valid output are also required.
# Keep false for local retrieval only. Apply changes to both backend and support-agent.
SUPPORT_LLM_ENABLED=false
# Use the provider's documented OpenAI-compatible API base URL.
# It must support Chat Completions and response_format={"type":"json_object"}.
SUPPORT_LLM_BASE_URL=https://api.openai.com/v1
# Exact model identifier available to the deployer's provider account; no default model.
SUPPORT_LLM_MODEL=
# Provider-issued secret, set by the deployer in local .env; never commit a real key.
SUPPORT_LLM_API_KEY=
# Generation attempts per UTC day across the deployment, not successful answers.
SUPPORT_MAX_DAILY_GENERATIONS=100
